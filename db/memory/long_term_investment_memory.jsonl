{"memory_id": "MEM_20260510_0007", "memory_type": "long_term_investment_memory", "status": "active", "title": "Allegations of forgery and horse-trading against TVK by AMMK chief", "summary": "Allegations of forgery and horse-trading against TVK by AMMK chief", "memory_scope": ["region", "company"], "time_horizon": "short_term", "linked_entities": ["T T V Dhinakaran", "TVK", "S Kamaraj", "AMMK"], "linked_themes": [], "linked_events": ["EVT_20260510_0164"], "linked_facts": [], "linked_claims": [], "source_refs": [{"document_id": "DOC_20260510_00063", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00063_C02", "supporting_text": "The TVK, which claims to be a pure force, has indulged in forgery and horse-trading,\u201d Dhinakaran alleged.", "published_at": "2026-05-09T17:04:23+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00050", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00050_C01", "supporting_text": "The TVK, contesting its maiden Assembly election, emerged as the single-largest party with 108 seats.", "published_at": "2026-05-09T22:02:53+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00076", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00076_C01", "supporting_text": "TVK, which won 108 seats, has sought support from several smaller camps to touch the magical number of 118 seats in the 234-seat Assembly.", "published_at": "2026-05-09T14:56:14+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00091", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00091_C01", "supporting_text": "\"TVK-led bloc now commands the support of 121 MLAs in the 234-member Assembly, comfortably crossing the majority mark of 118.\"", "published_at": "2026-05-09T06:31:00+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00072", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00072_C01", "supporting_text": "TVK legislators are staying at a resort or hotel in Mamallapuram near Chennai.", "published_at": "2026-05-09T15:14:20+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00092", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00092_C01", "supporting_text": "Governor Rajendra Vishwanath Arlekar reportedly declined Vijay\u2019s renewed claim to form the government, citing insufficient majority support in the Assembly.", "published_at": "2026-05-09T04:30:08+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00065", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00065_C01", "supporting_text": "-- TVK: 107   -- Congress: 5   -- CPI: 2   -- CPI(M): 2   -- VCK: 2   -- IUML: 2", "published_at": "2026-05-09T16:40:28+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00071", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00071_C01", "supporting_text": "The plea argued that the governor's decision amounts to an unconstitutional determination of a majority outside the Assembly.", "published_at": "2026-05-09T15:22:40+05:30", "source_reliability": "medium_high"}, {"document_id": "DOC_20260510_00058", "source_id": "moneycontrol", "chunk_id": "DOC_20260510_00058_C01", "supporting_text": "\"Our ties with the DMK will not get affected due to our stand, but it will help Vijay to form the government and also prevent the President\u2019s rule in the state,\" Thirumavalavan told reporters at a crowded press conference.", "published_at": "2026-05-09T19:14:36+05:30", "source_reliability": "medium_high"}], "why_stored": "fraud_or_accounting_concern with high severity", "future_use_cases": ["sector opportunity analysis", "thesis creation", "long-term tracking"], "recurrence": {"occurrence_count": 70, "source_diversity_count": 1}, "retention": {"retention_days": 1095, "expires_at": "2029-05-09", "decay_policy": "slow_decay"}, "created_at": "2026-05-10T10:24:54.289808+05:30", "updated_at": "2026-05-10T10:36:04.689534+05:30", "last_see